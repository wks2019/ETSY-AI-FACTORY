    { "id": "licence", "type": "licence", "layout": "prose", "title": "Licence",
      "subtitle": "What you may and may not do",
      "elements": { "blocks": [
        { "heading": "You may", "items": ["Use this planner on your own projects, at work or for clients", "Print unlimited copies for your own use", "Annotate digitally on any device you own", "Use it inside a business you own or work for"] },
        { "heading": "You may not", "items": ["Resell, share or redistribute the files in any form", "Sell printed copies or distribute copies to a team", "Include the files in another product or bundle", "Claim the design as your own"] },
        { "heading": "Fonts", "paragraphs": ["Cormorant Garamond and Inter are used under the SIL Open Font License 1.1. That licence covers the fonts only, not this document. All other design elements are original work."] }
      ] } },

    { "id": "readme", "type": "readme", "layout": "prose", "title": "Read Me",
      "subtitle": "One project, front to back",
      "elements": { "blocks": [
        { "heading": "Choose your size", "paragraphs": ["Four sizes are included and all four contain identical pages. A4 and US Letter suit the desk and the wall. A5 and Half Letter suit a tablet and a site visit, and print two-up on a full sheet."] },
        { "heading": "Digital use", "ordered": true, "items": ["Open the PDF in GoodNotes, Notability, Noteshelf, Xodo or any app that imports PDFs", "Import as a document, not as an image", "Switch the app to read mode to tap links, and write mode to write", "Use the tabs to move between phases of the project", "Tap Contents in the footer to return to the index from anywhere"] },
        { "heading": "Printing", "ordered": true, "items": ["Print at 100% scale and never select fit to page", "Use 100 to 120 gsm paper for double-sided printing", "Print only the sections this project needs — a small project will not use all of them"] },
        { "heading": "The order to work in", "ordered": true, "items": ["Charter first — why this project exists and who decides", "Scope next, including what is explicitly out", "Break the work down before estimating anything", "Set milestones, then build the timeline backwards from the deadline", "Register the risks before the first task, not after the first problem", "Review weekly. Close with lessons learned while they are still true"] },
        { "heading": "One planner, one project", "paragraphs": ["This planner covers a single project properly rather than twenty projects badly. If you run several at once, print or duplicate the file per project — the sections are designed to be filled completely, not sampled."] }
      ] } },

