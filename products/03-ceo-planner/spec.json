    { "id": "licence", "type": "licence", "layout": "prose", "title": "Licence",
      "subtitle": "What you may and may not do",
      "elements": { "blocks": [
        { "heading": "You may", "items": ["Use this planner to run your own company or practice", "Print unlimited copies for your own use", "Annotate digitally on any device you own", "Use it inside a business you own or lead"] },
        { "heading": "You may not", "items": ["Resell, share or redistribute the files in any form", "Sell printed copies or distribute copies to a team", "Include the files in another product or bundle", "Claim the design as your own"] },
