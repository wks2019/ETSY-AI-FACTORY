      ] } },

    { "id": "readme", "type": "readme", "layout": "prose", "title": "Read Me",
      "subtitle": "How to run this planner",
      "elements": { "blocks": [
        { "heading": "Choose your size", "paragraphs": ["Four sizes are included and all four contain identical pages. A4 and US Letter suit the desk and the boardroom. A5 and Half Letter suit a tablet and travel, and print two-up on a full sheet."] },
        { "heading": "Digital use", "ordered": true, "items": ["Open the PDF in GoodNotes, Notability, Noteshelf, Xodo or any app that imports PDFs", "Import as a document, not as an image", "Switch the app to read mode to tap links, and write mode to write", "Use the tabs to move between planning horizons", "Tap Contents in the footer to return to the index from anywhere"] },
        { "heading": "Printing", "ordered": true, "items": ["Print at 100% scale and never select fit to page", "Use 100 to 120 gsm paper for double-sided printing", "Print only the sections you use — the index lists every page"] },
        { "heading": "The operating rhythm", "paragraphs": ["Set the vision once. Set no more than three annual objectives. Convert each into quarterly key results with a number attached. Review the metrics weekly, not monthly — a quarter is lost one week at a time.", "The daily page exists to protect two hours of strategic work. If a week passes with none, the business is running you."] },
        { "heading": "What this planner deliberately does not do", "paragraphs": ["It does not calculate. A spreadsheet is better at arithmetic and worse at thinking. Writing a number by hand forces you to look at it, which is the entire point of a review page."] }
      ] } },

