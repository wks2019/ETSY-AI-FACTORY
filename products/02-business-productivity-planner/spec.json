      "title": "Business Productivity Planner" },

    { "id": "licence", "type": "licence", "layout": "prose", "title": "Licence",
      "subtitle": "What you may and may not do",
      "elements": { "blocks": [
        { "heading": "You may", "items": [
          "Use this planner for your own business or professional practice",
          "Print unlimited copies for your own use",
          "Annotate digitally on any device you own",
          "Use it inside a business you own or work for" ] },
        { "heading": "You may not", "items": [
          "Resell, share or redistribute the files in any form",
          "Sell printed copies",
          "Include the files in another product or bundle",
          "Claim the design as your own" ] },
        { "heading": "Fonts", "paragraphs": [
          "Cormorant Garamond and Inter are used under the SIL Open Font License 1.1. That licence covers the fonts only, not this document. All other design elements are original work." ] }
      ] } },

    { "id": "readme", "type": "readme", "layout": "prose", "title": "Read Me",
      "subtitle": "Set up in under a minute",
      "elements": { "blocks": [
        { "heading": "Choose your size", "paragraphs": [
          "Four sizes are included and all four contain identical pages. A4 and US Letter suit desk use and printing. A5 and Half Letter suit tablets and pocket binders, and print two-up on a full sheet." ] },
        { "heading": "Digital planning", "ordered": true, "items": [
          "Open the PDF in GoodNotes, Notability, Noteshelf, Xodo or any app that imports PDFs",
          "Import as a document, not as an image",
          "Switch the app to read mode to tap links, and write mode to write",
          "Tap the tabs at the top of any page to move between sections",
          "Tap Contents in the footer to return to the index from anywhere" ] },
        { "heading": "Printing", "ordered": true, "items": [
          "Print at 100% scale and never select fit to page",
          "Use 100 to 120 gsm paper for double-sided printing",
          "Print only the sections you use — the index lists every page" ] },
        { "heading": "Editing in Canva", "ordered": true, "items": [
          "Choose Create a design, then Import file, and select the PDF",
          "Text stays editable. Both fonts are available in Canva",
          "Check spacing after import before you export" ] },
        { "heading": "How this planner is meant to be used", "paragraphs": [
          "Start at the year page and set no more than three objectives. Break each one into a quarter. Pull the quarter into months, the month into weeks, and only then into days. Most planners fail because they start at the day. Finish each quarter on a review page before you plan the next one." ] }
      ] } },

    { "id": "index", "type": "index", "layout": "index", "title": "Contents",
