    { "id": "licence", "type": "licence", "layout": "prose", "title": "Licence",
      "subtitle": "What you may and may not do",
      "elements": { "blocks": [
        { "heading": "You may", "items": ["Use this planner for meetings you run or attend", "Print unlimited copies for your own use", "Annotate digitally on any device you own", "Use it inside a business you own or work for"] },
        { "heading": "You may not", "items": ["Resell, share or redistribute the files in any form", "Sell printed copies or distribute copies to a team", "Include the files in another product or bundle", "Claim the design as your own"] },
        { "heading": "Fonts", "paragraphs": ["Cormorant Garamond and Inter are used under the SIL Open Font License 1.1. That licence covers the fonts only, not this document. All other design elements are original work."] }
      ] } },

    { "id": "readme", "type": "readme", "layout": "prose", "title": "Read Me",
      "subtitle": "Meetings that end with something decided",
      "elements": { "blocks": [
        { "heading": "Choose your size", "paragraphs": ["Four sizes are included and all four contain identical pages. A4 and US Letter suit the desk and the meeting room. A5 and Half Letter suit a tablet carried between rooms, and print two-up on a full sheet."] },
        { "heading": "Digital use", "ordered": true, "items": ["Open the PDF in GoodNotes, Notability, Noteshelf, Xodo or any app that imports PDFs", "Import as a document, not as an image", "Switch the app to read mode to tap links, and write mode to write", "Use the tabs to move between agendas, actions and decisions", "Tap Contents in the footer to return to the index from anywhere"] },
        { "heading": "Printing", "ordered": true, "items": ["Print at 100% scale and never select fit to page", "Use 100 to 120 gsm paper for double-sided printing", "Print the meeting types you actually hold — most people need three or four"] },
        { "heading": "The three questions", "paragraphs": ["Before: what decision must this meeting produce? If there is no answer, send an email instead.", "During: who owes what, by when? An action without an owner and a date is a wish.", "After: did it happen? The action tracker is the only page that carries across meetings, and it is the page that makes the rest worth keeping."] },
        { "heading": "Why the action tracker is separate", "paragraphs": ["Most meeting templates bury actions at the foot of the notes page for that meeting. A week later nobody re-reads twelve notes pages to find what was owed. The tracker collects every action from every meeting in one place, which is the whole reason this planner is more than a stack of note sheets."] }
      ] } },

