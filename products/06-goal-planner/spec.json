    { "id": "readme", "type": "readme", "layout": "prose", "title": "Read Me",
      "subtitle": "Fewer goals, finished",
      "elements": { "blocks": [
        { "heading": "Choose your size", "paragraphs": ["Four sizes are included and all four contain identical pages. A4 and US Letter suit the desk. A5 and Half Letter suit a tablet or a bag, and print two-up on a full sheet."] },
        { "heading": "Digital use", "ordered": true, "items": ["Open the PDF in GoodNotes, Notability, Noteshelf, Xodo or any app that imports PDFs", "Import as a document, not as an image", "Switch the app to read mode to tap links, and write mode to write", "Use the tabs to move between horizons", "Tap Contents in the footer to return to the index from anywhere"] },
        { "heading": "Printing", "ordered": true, "items": ["Print at 100% scale and never select fit to page", "Use 100 to 120 gsm paper for double-sided printing", "Print the sections you will actually fill in"] },
        { "heading": "Start here, in this order", "ordered": true, "items": ["Write the vision. One page, no more than five years out", "Choose three annual goals. Not seven", "Convert each into a SMART worksheet with a number and a date", "Break the nearest one into milestones, then into an action plan", "Name the obstacle before you meet it", "Review weekly. Reflect quarterly. Record what you finished"] },
        { "heading": "Why three goals, and the page most people skip", "paragraphs": ["Goal planners fail because they invite you to list everything you want. Twelve goals is a wish list; three is a plan. The annual page has exactly three slots for that reason.", "The obstacle log is the page most people skip. Naming what will stop you, before it does, is the difference between a goal abandoned in March and one you finish."] }
      ] } },

