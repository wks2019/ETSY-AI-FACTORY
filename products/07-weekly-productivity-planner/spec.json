    { "id": "readme", "type": "readme", "layout": "prose", "title": "Read Me",
      "subtitle": "Set up once, then run the week",
      "elements": { "blocks": [
        { "heading": "Choose your size", "paragraphs": ["Four sizes are included and all four contain identical pages. A4 and US Letter suit the desk. A5 and Half Letter suit a tablet or a bag, and print two-up on a full sheet."] },
        { "heading": "Digital use", "ordered": true, "items": ["Open the PDF in GoodNotes, Notability, Noteshelf, Xodo or any app that imports PDFs", "Import as a document, not as an image", "Switch the app to read mode to tap links, and write mode to write", "Use the Week tab to reach the current week from anywhere", "Tap Contents in the footer to return to the index"] },
        { "heading": "Printing", "ordered": true, "items": ["Print at 100% scale and never select fit to page", "Use 100 to 120 gsm paper for double-sided printing", "Print the weekly set once and reprint it each week — the pages are undated"] }
      ] } },

    { "id": "howto", "type": "howto", "layout": "prose", "title": "How To Use",
      "subtitle": "The weekly cycle, in ninety minutes a week",
      "elements": { "blocks": [
        { "heading": "Friday — close the week, 30 minutes", "ordered": true, "items": ["Fill the Wins page before anything else", "Then Challenges, honestly", "Then Reflection — where the time actually went", "Carry unfinished tasks forward on the Next Week page"] },
        { "heading": "Sunday — open the week, 30 minutes", "ordered": true, "items": ["Read the Quarterly Focus page, then set Top Three Goals", "Fill the Weekly Calendar with fixed commitments first", "Allocate hours before assigning tasks — the Time Allocation page comes before the Task Manager", "Set the habits, meals and exercise for the week"] },
        { "heading": "Daily — five minutes", "paragraphs": ["Mark the trackers. That is all. The planning was done on Sunday, and the reviewing happens on Friday. A weekly system that needs daily planning is a daily system wearing the wrong label."] },
        { "heading": "Why thirteen weeks", "paragraphs": ["Thirteen weeks is one quarter. Most weekly planners give you one weekly spread and expect you to reprint it, which means the review pages are never kept and nothing compounds. This planner contains the full cycle thirteen times, so a quarter of weeks sits in one file and the reflection pages accumulate into evidence."] }
      ] } },

